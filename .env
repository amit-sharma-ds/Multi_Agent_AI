# OPENAI_API_KEY=your_openai_key
GROQ_API_KEY=
LLM_PROVIDER=groq
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Optional OpenAI provider: uncomment both lines when needed.
# OPENAI_PROVIDER=openai
# LLM_PROVIDER=openai

# Local Ollama backup: install Ollama and pull the model first, then uncomment:
# LLM_PROVIDER=ollama



### There are 3 API models in my code.
## When you need one, uncomment it and use it.
# In this env file, right now Groq is using
# LLM_PROVIDER=groq
# OPENAI_PROVIDER=openai
# LLM_PROVIDER=openai
